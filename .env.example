# .env.example -- copy to .env and edit. Every key is optional.
#
#   cp .env.example .env && ./bin/qc doctor
#
# `.env` holds what is true of THIS MACHINE: where the binaries are, which ASR
# model to load, and how to get out to the network. It is gitignored, which is
# why proxy credentials belong here and nowhere else.
#
# Precedence for any key:  shell environment  >  .env  >  qc.toml  >  built-in
# `qc doctor -v` prints which of those won for every entry.
#
# NOTHING that changes a rendered pixel goes here. Style geometry, colour and
# type live in templates/*.yaml, which is committed and reviewed -- a
# look-affecting value in an untracked file makes a render unreproducible.


# ---------------------------------------------------------------------------
# Binaries. Only needed when a tool is not on PATH, or to PIN an exact build.
# ---------------------------------------------------------------------------
# The golden media md5s are only valid for the ffmpeg recorded in
# tests/golden/ENV.txt, so pinning ffmpeg is the supported way to keep those
# tiers meaningful across an upgrade.
#QC_FFMPEG=/opt/homebrew/bin/ffmpeg
#QC_FFPROBE=/opt/homebrew/bin/ffprobe
#QC_YT_DLP=/opt/homebrew/bin/yt-dlp
# The `claude` CLI backs the coherence judge and the line-breaker. Absent is
# fine: both fall back to a documented heuristic and the report says which ran.
#QC_CLAUDE_BIN=/opt/homebrew/bin/claude


# ---------------------------------------------------------------------------
# Interpreters. Default to tools/<name>-venv/bin/python, falling back to the
# running python when that path does not exist -- which is what makes a
# single-venv install work with no configuration at all.
# ---------------------------------------------------------------------------
# Keep `render` on an interpreter whose Pillow has RAQM (Arabic shaping), and
# never pip-install whisper or opencv into it.
#QC_RENDER_PYTHON=/path/to/render-venv/bin/python
#QC_AUTHOR_PYTHON=/path/to/author-venv/bin/python
#QC_ASR_PYTHON=/path/to/asr-venv/bin/python


# ---------------------------------------------------------------------------
# Speech recognition.
# ---------------------------------------------------------------------------
# backend: mlx (Apple silicon, the reference backend the committed timings were
# produced with) | faster (faster-whisper / CTranslate2, CPU or CUDA, portable).
# Default: mlx on Apple silicon, faster everywhere else.
#
# Switching backends RE-TIMES a clip: the two runtimes do not emit identical word
# boundaries. Existing ASR caches record the backend that wrote them and are
# reused with a warning rather than silently re-cut.
#QC_ASR_BACKEND=faster
#
# Model id OR an absolute path to a downloaded model directory -- both backends
# accept either, so an offline machine can point at local weights.
#QC_ASR_MODEL=mlx-community/whisper-large-v3-turbo
#QC_ASR_MODEL=/models/faster-whisper-large-v3-turbo-ct2


# ---------------------------------------------------------------------------
# Egress / proxy pool.  Needed on a cloud host, where YouTube bot-checks the
# datacentre IP outright.  `qc source add` is the ONLY command that leaves the
# machine; everything else is local.
# ---------------------------------------------------------------------------
# Escalation is fixed:   static residential -> datacentre -> fail.
# No direct connection is attempted once a pool is configured, because a bare
# cloud IP gets bot-checked anyway and burning it teaches nothing.
#
# Two measured constraints behind that order:
#  * A signed googlevideo URL embeds the exit IP that resolved it, so a ROTATING
#    proxy 403s the media fetch. Only sticky/static exits can download. Within
#    one `source add` the metadata call and the media fetch are pinned to the
#    same exit for the same reason.
#  * The bot check fires at the player-API stage, before any bytes move, and it
#    burns PER EXIT IP. Retrying one endpoint harder makes it worse; moving to
#    the next endpoint is what recovers.
#
# Format: comma-separated user:pass@host:port (http:// is assumed).
# Five static residential endpoints is the intended shape of the first tier.
#QC_PROXY_STATIC=user:pass@1.2.3.4:5001,user:pass@1.2.3.5:5002,user:pass@1.2.3.6:5003,user:pass@1.2.3.7:5004,user:pass@1.2.3.8:5005
#QC_PROXY_DATACENTER=user:pass@10.0.0.1:8001,user:pass@10.0.0.2:8002
#
# auto (default) = use the pool when one is configured, go direct when not.
# always = fail rather than ever going direct.  never = ignore the pool.
#QC_PROXY_ENABLED=auto


# ---------------------------------------------------------------------------
# Alternate config file locations (rarely needed).
# ---------------------------------------------------------------------------
#QC_ENV_FILE=/etc/quran-clips/env
#QC_CONFIG=/etc/quran-clips/qc.toml
