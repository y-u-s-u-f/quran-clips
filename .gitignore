# ==========================================================================
# quran-clips — track the CREATION PROCESS, not the output.
# Tracked: pipeline/, assets/ (fonts + quran editions), docs/, .agents/,
#          tests/, and the reel configs of two example sources under sources/.
# Ignored: downloaded footage, transcripts, the rendered reels under reels/,
#          and the venvs + caches under tools/.
# ==========================================================================

# --- sources/: one folder per source video ---------------------------------
# Everything here stays local except the *.yaml of two example sources, each
# re-fetchable from the `# source:` URL at the top of its configs:
# hajri-23-taraweeh (one reel in all three styles) and YkXjYyKwHJ4 (Badr
# al-Turki, horizontal). Media, captions and Whisper output are re-derivable
# (fetch.py / transcribe.py). Git will not descend into an excluded
# directory, so the kept folders are re-admitted and their yamls re-admitted
# inside them.
sources/*
!sources/hajri-23-taraweeh/
!sources/YkXjYyKwHJ4/
sources/*/*
!sources/*/*.yaml

# --- reels/: generated output, flat -- never tracked ------------------------
reels/

# --- venvs, downloaded models, render caches --------------------------------
tools/

# --- Media, anywhere --------------------------------------------------------
*.mp4
*.mov
*.wav
*.m4a
# README demo videos — the one place an .mp4 is tracked on purpose.
!docs/*.mp4

# --- Machine-level config: paths, models, PROXY CREDENTIALS ----------------
# .env carries proxy passwords and Meta tokens, so it must never be committed;
# .env.example documents every key and DOES ship.
.env
.env.bak*

# --- Python / OS cruft ------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.DS_Store
