# ==========================================================================
# quran-clips — track the CREATION PROCESS, not the output.
# Tracked: scripts/, templates/, .claude/, assets/ (fonts + scene images),
#          clips/*/clip.yaml + tags.yaml, style/**/*.md specs + fx code.
# Ignored: downloaded footage, exported reels, per-clip renders, the venv.
# ==========================================================================

# --- Downloaded / exported / recreatable trees -----------------------------
# downloaded YouTube source videos + subtitles (re-downloadable).
# EXCEPT sources/meta/: one small yaml per video (title, duration, fps,
# dimensions, uploader) written by `qc source add`. That is derived knowledge
# we paid a network round-trip for and that `qc locate` reads, so it must
# survive a clean checkout even though the .mp4 next to it does not.
# Git will not descend into an excluded DIRECTORY, so the exclusion has to be
# `sources/*` (contents) rather than `sources/` for the negation to be
# reachable at all.
sources/*
!sources/meta/
# exported final reels (regenerable from clip.yaml)
reels/
# python venv for ASR (recreate with pip install)
tools/

# --- Per-clip intermediates and renders ------------------------------------
clips/*/work/
clips/*/output/

# --- Throwaway A/B test harnesses ------------------------------------------
# Any clip folder whose name starts with _ is scratch and never ships.
clips/_*/

# --- Finder aliases dropped in clip folders by export_reel ------------------
# Named after the reel (RECITER-SURAH-a-b, no extension), so an uppercase entry
# directly inside a clip folder is always one; a clip's own files are lowercase.
# These are macOS alias blobs holding an absolute local path — they are outputs,
# they are binary, and they resolve to nothing on any other machine.
clips/*/[A-Z]*

# --- Media, anywhere --------------------------------------------------------
*.mp4
*.mov
*.wav
*.m4a

# --- Reference frames / QA stills (extracted or rendered, regenerable) ------
style/**/*.jpg
style/**/*.jpeg
style/**/*.png

# --- Generated reports ------------------------------------------------------
pipeline-review.html

# --- Python / OS cruft ------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.DS_Store

# ===========================================================================
# Explicit keeps — these are INPUTS to the pipeline, never outputs.
# (Defensive negations: nothing above should swallow them.)
# ===========================================================================
!scripts/
!templates/
!.claude/
!assets/
!assets/fonts/*.ttf
!assets/reciters/*.png
!clips/*/clip.yaml
!clips/*/tags.yaml
!style/**/*.md
!*.excalidraw
