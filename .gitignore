# ==========================================================================
# quran-clips — track the CREATION PROCESS, not the output.
# Tracked: pipeline/, assets/ (fonts + quran editions + scene images), docs/,
#          .claude/, the per-source reel configs and meta under sources/*/,
#          and the archived first/second-generation code under legacy/.
# Ignored: downloaded footage, transcripts, the rendered reels under reels/,
#          and the venvs under tools/.
# ==========================================================================

# --- sources/: one folder per source video ---------------------------------
# Media, captions and Whisper output are re-derivable (fetch.py /
# transcribe.py); the authored *.yaml reel configs and the fetched meta.yaml
# are the creation process and DO ship. Git will not descend into an excluded
# directory, so contents are excluded per-folder and the yamls re-admitted.
sources/*
!sources/*/
sources/*/*
!sources/*/*.yaml

# --- reels/: generated output, flat -- never tracked ------------------------
reels/

# --- venvs + downloaded models ----------------------------------------------
tools/

# --- Media, anywhere --------------------------------------------------------
*.mp4
*.mov
*.wav
*.m4a

# --- legacy/: archived code is tracked; its caches and renders are not ------
legacy/caches/
legacy/clips/*/*
legacy/style/**/*.jpg
legacy/style/**/*.jpeg
legacy/style/**/*.png

# --- Machine-level config: paths, models, PROXY CREDENTIALS ----------------
# .env carries proxy passwords, so it must never be committed; .env.example
# documents every key and DOES ship.
.env
.env.bak*
qc.toml
!.env.example
!legacy/qc.toml.example

# --- Python / OS cruft ------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.DS_Store

# ===========================================================================
# Explicit keeps — INPUTS to the pipeline, never outputs.
# ===========================================================================
!assets/
!assets/fonts/*.ttf
!assets/reciters/*.png
!*.excalidraw

# The archived example recipes the legacy golden fixtures were recorded
# against (also the README demo clips).
!legacy/clips/*/clip.yaml

# README demo videos — the one place an .mp4 is tracked on purpose.
!docs/*.mp4
